# Copy to .env and fill in ONE provider. Read by server.py; never sent to the browser.

# ── Google AI Studio (Gemini), via its OpenAI-compatible endpoint ──
#    Key: https://aistudio.google.com/apikey
AI_API_KEY=
AI_UPSTREAM_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-3.6-flash

# ── Other providers — uncomment one block instead ──
#
# Anthropic (needs `pip install anthropic`, gives schema-enforced output):
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-haiku-4-5
#
# Hugging Face Inference Providers:
# AI_API_KEY=hf_...
# AI_UPSTREAM_URL=https://router.huggingface.co/v1/chat/completions
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Provider is inferred (sk-ant-… or claude-… means Anthropic; everything else
# uses the OpenAI-compatible path). Force it with AI_PROVIDER=anthropic|openai.
